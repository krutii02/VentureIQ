# ─── Copy this file to .env and fill in values for local development ───
# In production (Railway), set these directly as environment variables.

# Django
SECRET_KEY=your-random-secret-key-here
DEBUG=False

# Allowed hosts — comma-separated, no spaces
# e.g. ventureiq-backend.up.railway.app,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Railway auto-injects this when you add a PostgreSQL plugin
# Leave blank to use SQLite locally
DATABASE_URL=

# CORS — Your Vercel frontend URL (comma-separated for multiple)
# e.g. https://ventureiq.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
